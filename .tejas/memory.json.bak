        "id": "5555ebd9-6796-404a-8af5-eb6b0c4f5185",
        "created_at": "2026-04-04T14:14:15.311Z",
        "used_count": 0,
        "last_used": null,
        "name": "list_largest_python_file",
        "trigger": "list all Python files in this folder and tell me which one is largest",
        "description": "List all Python files in the current folder and identify the largest one",
        "steps": [
          {
            "step": 1,
            "action": "shell",
            "description": "List all Python files in the current folder",
            "command": "find . -type f -name '*.py'",
            "path": null,
            "content": null,
            "expected_output": "A list of Python files in the current folder"
          },
          {
            "step": 2,
            "action": "shell",
            "description": "Find the largest Python file",
            "command": "find . -type f -name '*.py' -exec du -h {} + | sort -rh | head -1",
            "path": null,
            "content": null,
            "expected_output": "The path and size of the largest Python file"
          }
        ],
        "agent": "file"
      },
