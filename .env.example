# ─────────────────────────────────────────────────────────────────────────────
#  TEJAS — Environment Variables Example
#  Copy this to .env and fill in your keys
#  ⚠ NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── TELEGRAM BOT (REQUIRED for remote control) ──────────────────────────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Authorized User IDs (comma separated)
# Get yours by messaging @userinfobot
TELEGRAM_AUTHORIZED_IDS=

# ── AI MODELS ────────────────────────────────────────────────────────────────
# Primary model: groq | claude | deepseek | openai | gemini | xai | ollama
TEJAS_MODEL=groq

# Groq (FAST & FREE - recommended for v2)
# Get key: https://console.groq.com
GROQ_API_KEY=

# Anthropic Claude
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# DeepSeek
# Get key: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI ChatGPT
# Get key: https://platform.openai.com
OPENAI_API_KEY=

# Google Gemini
# Get key: https://aistudio.google.com
GEMINI_API_KEY=

# xAI Grok
# Get key: https://console.x.ai
XAI_API_KEY=

# Tavily (Web Search Agent)
# Get key: https://tavily.com
TAVILY_API_KEY=

# ── LOCAL AI (OLLAMA) ─────────────────────────────────────────────────────────
# Default: http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── TEJAS SETTINGS ───────────────────────────────────────────────────────────
TEJAS_VERBOSE=false
TEJAS_AUTO_LEARN=true
TEJAS_BANNER=true
TEJAS_THEME=dark
