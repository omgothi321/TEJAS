# ─────────────────────────────────────────────────────────────────────────────
#  TEJAS — Environment Variables
#  Copy this to .env and fill in your keys
#  ⚠ NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── AI MODEL ─────────────────────────────────────────────────────────────────
# Which model to use: claude | deepseek | openai | gemini | ollama
TEJAS_MODEL=deepseek

# ── API KEYS (set whichever model you use) ────────────────────────────────────

# Anthropic Claude
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# DeepSeek (your previous model — fast + cheap)
# Get key: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI ChatGPT
# Get key: https://platform.openai.com
OPENAI_API_KEY=

# Google Gemini
# Get key: https://aistudio.google.com
GEMINI_API_KEY=

# ── OLLAMA (local, no key needed) ─────────────────────────────────────────────
# Default: http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── TEJAS SETTINGS ───────────────────────────────────────────────────────────
TEJAS_VERBOSE=false
TEJAS_AUTO_LEARN=true
